# Platform Database (local Postgres or Supabase)
POSTGRES_PORT=5433
POSTGRES_USER=nigrani_app
POSTGRES_PASSWORD=nigrani_dev_password
POSTGRES_DB=nigrani
DATABASE_URL=postgresql://nigrani_app:nigrani_dev_password@localhost:5433/nigrani

# Job Queue
REDIS_URL=redis://localhost:6379/0

# Platform Auth (Supabase)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Model Configuration
MODEL_ADAPTER=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:3b

# GitHub Integration
GITHUB_WEBHOOK_SECRET=your-webhook-secret-placeholder

# Sandbox Execution Limits
SANDBOX_TIMEOUT_SECONDS=60
SANDBOX_MEMORY_MB=1024
