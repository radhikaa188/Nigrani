# Sandbox database and PostgREST environment configuration
SANDBOX_DB_PORT=5435
SANDBOX_POSTGREST_PORT=5436
SANDBOX_DB_NAME=sandbox_db
SANDBOX_DB_USER=sandbox_admin
SANDBOX_DB_PASSWORD=sandbox_admin_password
SANDBOX_AUTHENTICATOR_USER=authenticator
SANDBOX_AUTHENTICATOR_PASSWORD=authenticator_password
# JWT Secret for PostgREST HMAC-SHA256 (minimum 32 characters)
SANDBOX_JWT_SECRET=sandbox-local-dev-jwt-secret-min-32-chars-long
